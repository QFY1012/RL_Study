   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "Keep measuring the response-time win."
  },
  {
   "tag": "h2",
   "y": 3814,
   "x": 128,
   "w": 392,
   "in_svg": false,
   "hidden": false,
   "text": "Roll forward on speed. Gate the rollout on Dermatology."
  },
  {
   "tag": "p",
   "y": 3831,
   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "Treatment is faster on 39 of 42 days and in all five departments; the within-two-minute share rises +15.95 pp."
  },
  {
   "tag": "span",
   "y": 3896,
   "x": 594,
   "w": 28,
   "in_svg": false,
   "hidden": false,
   "text": "02"
  },
  {
   "tag": "h3",
   "y": 3897,
   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "Do not call overall completion a win."
  },
  {
   "tag": "p",
   "y": 3923,
   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "The observed difference is -0.08 pp, with a 95% CI from -1.03 to +0.87 pp. Investigate whether shorter consults affect any downstream quality measure."
  },
  {
   "tag": "p",
   "y": 3954,
   "x": 128,
   "w": 380,
   "in_svg": false,
   "hidden": false,
   "text": "The response-time improvement is consistent across observed cuts. Completion and follow-up need a segmented readout."
  },
  {
   "tag": "span",
   "y": 4005,
   "x": 594,
   "w": 28,
   "in_svg": false,
   "hidden": false,
   "text": "03"
  },
  {
   "tag": "h3",
   "y": 4006,
   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "Audit Dermatology routing and the pre-doctor queue."
  },
  {
   "tag": "p",
   "y": 4032,
   "x": 640,
   "w": 653,
   "in_svg": false,
   "hidden": false,
   "text": "Early loss rises +5.04 pp, and every Dermatology complaint group moves in the wrong direction. Review this segment before a broad rollout."
  },
  {
   "tag": "span",
   "y": 4044,
   "x": 128,
   "w": 140,
   "in_svg": false,
   "hidden": false,
   "text": "Speed ≠ completed care"
