   "w": 508,
   "in_svg": false,
   "hidden": false,
   "text": "7,933 completed control consultations and 7,903 completed test consultations."
  },
  {
   "tag": "span",
   "y": 4684,
   "x": 1156,
   "w": 84,
   "in_svg": false,
