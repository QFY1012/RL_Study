   "in_svg": false,
   "hidden": false,
   "text": "03 / THE LIKING GAP"
  },
  {
   "tag": "h2",
   "y": 1220,
   "x": 136,
   "w": 571,
   "in_svg": false,
   "hidden": false,
   "text": "Enjoyment isn’t always mutual to the same degree."
  },
  {
   "tag": "h2",
   "y": 1220,
   "x": 733,
   "w": 571,
   "in_svg": false,
   "hidden": false,
   "text": "People tend to be liked more than they think."
  },
  {
   "tag": "p",
   "y": 1306,
   "x": 136,
   "w": 571,
   "in_svg": false,
   "hidden": false,
   "text": "Partners report identical enjoyment in 26.5% of complete pairs. In 17.2%, their scores differ by at least three points."
  },
  {
   "tag": "p",
   "y": 1306,
   "x": 733,
   "w": 571,
   "in_svg": false,
   "hidden": false,
   "text": "Matching each person’s estimate to their partner’s actual rating reveals a mean gap of 0.64 points."
