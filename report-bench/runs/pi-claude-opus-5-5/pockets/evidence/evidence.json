 "text": [
  {
   "tag": "h1",
   "y": 64,
   "x": 272,
   "w": 896,
   "in_svg": false,
   "hidden": false,
   "text": "Women's jeans come with shallower front pockets"
  },
  {
   "tag": "p",
   "y": 191,
   "x": 272,
   "w": 760,
   "in_svg": false,
   "hidden": false,
   "text": "This data has front and back pocket measurements for 80 pairs of jeans, 40 men's and 40 women's , from 20 popular brands. Women's front pockets are much shallower than men's. Back pockets are about the same size for both."
  },
  {
   "tag": "p",
   "y": 312,
   "x": 272,
   "w": 896,
   "in_svg": false,
   "hidden": false,
   "text": "All measurements are in centimetres. Front-pocket depth is the deepest point of the pocket bag, measured from the top of the waistband."
  },
  {
   "tag": "span",
   "y": 412,
   "x": 295,
   "w": 81,
   "in_svg": false,
   "hidden": false,
   "text": "14.3"
  },
  {
   "tag": "span",
   "y": 412,
   "x": 442,
   "w": 77,
   "in_svg": false,
   "hidden": false,
   "text": "23.1"
  },
  {
   "tag": "b",
   "y": 415,
   "x": 295,
   "w": 239,
   "in_svg": false,
   "hidden": false,
   "text": "vs"
  },
  {
   "tag": "b",
   "y": 415,
   "x": 600,
   "w": 239,
   "in_svg": false,
   "hidden": false,
   "text": "1 of 40"
  },
  {
   "tag": "b",
   "y": 415,
   "x": 906,
   "w": 239,
   "in_svg": false,
   "hidden": false,
   "text": "20 of 20"
  },
  {
   "tag": "span",
   "y": 465,
   "x": 295,
   "w": 184,
   "in_svg": false,
   "hidden": false,
   "text": "average front pocket depth, women's vs men's"
  },
  {
   "tag": "span",
   "y": 465,
   "x": 600,
   "w": 227,
   "in_svg": false,
   "hidden": false,
   "text": "women's front pockets as deep as the shallowest men's one (20.0)"
  },
  {
   "tag": "span",
   "y": 465,
   "x": 906,
   "w": 206,
   "in_svg": false,
   "hidden": false,
   "text": "brands where the men's front pockets are deeper on average"
  },
  {
   "tag": "h2",
   "y": 602,
   "x": 272,
   "w": 896,
   "in_svg": false,
   "hidden": false,
   "text": "Front pockets: two groups that barely overlap"
  },
  {
   "tag": "p",
   "y": 651,
   "x": 272,
   "w": 896,
   "in_svg": false,
   "hidden": false,
   "text": "Each dot is one pair of jeans. Men's front pockets run from 20.0 to 28.0 deep; women's run from 11.5 to 21.5. Only one women's pair, Abercrombie's Simone High Rise Slim at 21.5, reaches the shallowest men's pocket. On average women's front pockets are 14.3 deep against 23.1 for men's, and a little narrower too: 15.2 across the opening against 16.4."
  },
  {
   "tag": "div",
   "y": 783,
   "x": 297,
   "w": 846,
   "in_svg": false,
   "hidden": false,
   "text": "Men's Women's"
  },
  {
   "tag": "text",
   "y": 819,
   "x": 852,
   "w": 48,
   "in_svg": true,
   "hidden": false,
   "text": "avg 23.1"
  },
  {
