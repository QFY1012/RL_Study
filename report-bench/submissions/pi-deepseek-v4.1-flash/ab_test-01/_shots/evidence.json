   "y": 3742,
   "x": 1177,
   "w": 35,
   "in_svg": true,
   "hidden": false,
   "text": "23 Dec"
  },
  {
   "tag": "li",
   "y": 3757,
   "x": 140,
   "w": 543,
   "in_svg": false,
   "hidden": false,
   "text": "It is not a waiting-time story. Dermatology waits improved like everywhere else, from a 107-second median in control to 86 seconds in the experiment. Users left despite being answered sooner, which points at the quality or fit of the reply rather than its speed."
  },
