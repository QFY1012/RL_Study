   "x": 762,
   "w": 22,
   "in_svg": true,
   "hidden": false,
   "text": "78%"
  },
  {
   "tag": "li",
   "y": 3659,
   "x": 140,
   "w": 543,
   "in_svg": false,
   "hidden": false,
   "text": "It hits every platform. Abandonment is higher in the experiment on Android (13.3% against 7.2%), on iOS (12.0% against 8.2%) and on the WeChat mini-program (12.7% against 7.5%)."
  },
  {
   "tag": "text",
   "y": 3717,
   "x": 762,
   "w": 22,
