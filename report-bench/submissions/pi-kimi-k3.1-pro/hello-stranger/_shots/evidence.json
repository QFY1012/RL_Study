   "x": 443,
   "w": 135,
   "in_svg": false,
   "hidden": false,
   "text": "19–66"
  },
  {
   "tag": "b",
   "y": 4399,
   "x": 673,
   "w": 320,
   "in_svg": false,
   "hidden": false,
   "text": "Gaps recomputed transparently"
