sign(group='sitters'), d.loc[d.PCT_STAND>50].assign(group='standers')]).assign(pay=lambda x: pd.to_numeric(x['A_MEAN'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).groupby('group')['pay'].mean()\"\n  },\n  {\n    \"id\": \"sitters-problem-daily\",\n    \"source\": \"Sitters are more likely to have to solve problems every day.\",\n    \"claim\": \"Across sitter occupations, the mean share of workers who must solve problems once per day is 16.7%, against 7.2% across stander occupations.\",\n    \"tables\": {\n      \"d\": \"data/data.csv\"\n    },\n    \"code\": \"pd.concat([d.loc[(d.PCT_SIT>50) & ~(d.PCT_STAND>50)].assign(group='sitters'), d.loc[d.PCT_STAND>50].assign(group='standers')]).assign(daily=lambda x: pd.to_numeric(x['Percent of workers, problem solving is required once per day'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).groupby('group')['daily'].mean()\"\n  },\n  {\n    \"id\": \"sitters-pause-autonomy\",\n    \"source\": \"And Sitters get more autonomy. These are workers who say they can pause work when they need to.\",\n    \"claim\": \"Across sitter occupations, 82.6% of workers can pause work and 17.4% cannot; across stander occupations, 44.6% can pause work and 55.4% cannot.\",\n    \"tables\": {\n      \"d\": \"data/data.csv\"\n    },\n    \"code\": \"pd.concat([d.loc[(d.PCT_SIT>50) & ~(d.PCT_STAND>50)].assign(group='sitters'), d.loc[d.PCT_STAND>50].assign(group='standers')]).assign(can_pause=lambda x: pd.to_numeric(x['Percent of workers, with the ability to pause work'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce'), cannot_pause=lambda x: pd.to_numeric(x['Percent of workers, without the ability to pause work'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).groupby('group')[['can_pause', 'cannot_pause']].mean()\"\n  },\n  {\n    \"id\": \"sitters-telework\",\n    \"source\": \"Sitters are also more likely to say they can work remotely.\",\n    \"claim\": \"Across sitter occupations, the mean share of workers with telework available is 25.8%, against 1.6% across stander occupations.\",\n    \"tables\": {\n      \"d\": \"data/data.csv\"\n    },\n    \"code\": \"pd.concat([d.loc[(d.PCT_SIT>50) & ~(d.PCT_STAND>50)].assign(group='sitters'), d.loc[d.PCT_STAND>50].assign(group='standers')]).assign(telework=lambda x: pd.to_numeric(x['Percent of workers, with telework available'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).groupby('group')['telework'].mean()\"\n  },\n  {\n    \"id\": \"telework-overall-share\",\n    \"source\": \"Only a tiny portion of Americans have this option.\",\n    \"claim\": \"Across all occupations in the data, 12.6% of workers have telework available.\",\n    \"tables\": {\n      \"d\": \"data/data.csv\"\n    },\n    \"code\": \"d.assign(v=pd.to_numeric(d['Percent of workers, with telework available'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).pipe(lambda x: np.average(x['v'].dropna(), weights=x.loc[x['v'].notna(), 'TOT_EMP']))\"\n  },\n  {\n    \"id\": \"standers-rarely-problem-solve\",\n    \"source\": \"Standers are more likely to say they never or rarely have to problem-solve for their job.\",\n    \"claim\": \"Across stander occupations, the mean share of workers whose problem solving is required less often than monthly is 70.1%, against 33.8% across sitter occupations.\",\n    \"tables\": {\n      \"d\": \"data/data.csv\"\n    },\n    \"code\": \"pd.concat([d.loc[(d.PCT_SIT>50) & ~(d.PCT_STAND>50)].assign(group='sitters'), d.loc[d.PCT_STAND>50].assign(group='standers')]).assign(rare=lambda x: pd.to_numeric(x['Percent of workers, problem solving is required less often than monthly, including never'].astype(str).str.replace(r'^[<>]', '', regex=True), errors='coerce')).groupby('group')['rare'].mean()\"\n  },\n  {\n    \"id\": \"standers-crouch\",\n    \"source\": \"Standers are more likely to say they crouch at work\\u2014everyone from nurses to ele